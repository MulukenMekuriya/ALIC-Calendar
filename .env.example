# Supabase Configuration
# Get these values from your Supabase project dashboard (Settings > API)

# Your Supabase project URL
# Example: https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=your_supabase_project_url_here

# Supabase anonymous key (public, safe to use in frontend)
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# App URL - Used for password reset redirects
# Example: https://addislidet.info (production) or http://localhost:5173 (development)
VITE_APP_URL=http://localhost:5173

# Supabase service role key (KEEP THIS SECRET!)
# Only needed for running seed scripts locally
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# WARNING: Never commit this key to version control!
# WARNING: Never deploy this to frontend (Vercel, etc.)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Resend API Key for email notifications (Edge Functions only)
# Get this from https://resend.com/api-keys
RESEND_API=your_resend_api_key_here

# Resend From Email (Edge Functions only)
# Must use a verified domain from https://resend.com/domains
# Example: "Event Calendar <noreply@yourdomain.com>"
RESEND_FROM_EMAIL="Event Calendar <team@addislidet.info>"

# Online giving — the church's Stripe payment link (Edge Functions do not need
# this; it is the public URL the /give page and the member portal link to).
# Optional: the link is hard-coded in src/shared/constants/giving.ts, and this
# only overrides it, for when the church rotates the link.
VITE_STRIPE_GIVING_URL=https://buy.stripe.com/3cIdR8fXp3D5g6u33M4Rq00

# Stripe webhook (Edge Function `stripe-giving-webhook` only).
# Optional. Without these the function is never called and Stripe gifts reach
# the ledger through Giving -> Import instead; both paths dedupe on the same
# Stripe reference, so setting them later loses nothing.
# Get the signing secret from the Stripe dashboard when you add the endpoint.
STRIPE_WEBHOOK_SECRET=whsec_your_signing_secret_here
# The branch a payment link's gifts belong to. Overridden per-gift by an
# `organization_id` key in the payment link's Stripe metadata.
STRIPE_GIVING_ORGANIZATION_ID=your_organization_uuid_here

# Instructions:
# 1. Copy this file to .env in the same directory
# 2. Replace the placeholder values with your actual Supabase credentials
# 3. Never commit .env to git (it's already in .gitignore)
# 4. For production deployment (Vercel), only set VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY
